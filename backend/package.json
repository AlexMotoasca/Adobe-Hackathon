{
  "name": "mindmarket-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "worker": "tsx --env-file=.env.local src/worker.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "check:provider": "tsx --env-file=.env.local scripts/check-provider.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "^16.2.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12",
    "csv-parse": "^6.1.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0"
  }
}
